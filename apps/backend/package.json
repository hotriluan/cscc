{
  "name": "@cscc/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/e2e-ntr001.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/scripts/db-cli.ts seed",
    "db:reset": "tsx src/scripts/db-cli.ts reset",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx src/scripts/db-cli.ts seed"
  },
  "dependencies": {
    "@cscc/shared": "*",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}