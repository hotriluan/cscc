DATABASE_URL="postgresql://postgres:password123@localhost:5432/cscc_db?schema=public"
PORT=4000

# --- Admin Backup & Restore ---
# 32 random bytes, base64 (openssl rand -base64 32). Seals the stored Drive credentials and backup passphrase.
# Keep an offline copy: losing it makes the stored secrets unreadable.
BACKUP_MASTER_KEY=
# Backup folder (must be outside the project/web root). Production: /var/backups/cscc. Dev default: ./.backups
BACKUP_DIR=
# Optional directory containing pg_dump / pg_restore when they are not on PATH
PG_BIN_DIR=
# Optional max size of a backup file uploaded from a browser, in MB (default 2048)
BACKUP_MAX_UPLOAD_MB=
# Optional: Google Drive OAuth credentials can also be provided here (or via client_secret*.json)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
